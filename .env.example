# .env.example (Safe template; never commit actual secrets)

# Guard (.env.guard)
SERVICE_KEY=example_service_key_32bytes_hex
AUDIT_HMAC_KEY=example_audit_hmac_key_32bytes_hex
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=example_openrouter_api_key_primary
OPENROUTER_API_KEY_FAILOVER_1=example_openrouter_failover_1
# OPENROUTER_API_KEY_FAILOVER_2...7

# Gateway (.env.gateway)
SERVICE_KEY=example_service_key_32bytes_hex
AUDIT_HMAC_KEY=example_audit_hmac_key_32bytes_hex
TOOL_CREDENTIAL=example_tool_credential_token
GUARD_URL=http://localhost:8001

# Agents (.env.agents)
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=example_openrouter_api_key_primary
GATEWAY_URL=http://localhost:8002

# Demo (.env.demo)
DEMO_MODE=true
GUARD_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8002
AGENTS_URL=http://localhost:8003
