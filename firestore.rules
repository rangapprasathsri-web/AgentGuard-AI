rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin SDK bypasses these rules automatically, so we don't need to explicitly allow backend writes.
    // Allow read-only for clients on specific collections
    match /decisions/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /approvals/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /audit/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /health/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
